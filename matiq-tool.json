{
  "schema": 1,
  "id": "com.matiq.schema",
  "name": "DBSchema",
  "description": "Design database schemas locally. Edit DBML and explore tables and relationships.",
  "version": "0.1.0",
  "sdk": 1,
  "dataVersion": 1,
  "runtime": "electron-45.2.3",
  "targets": [
    "darwin-arm64",
    "darwin-x64",
    "win32-x64",
    "win32-arm64",
    "linux-x64"
  ],
  "capabilities": [
    "files"
  ],
  "adapter": "src/tool.cjs",
  "workspace": "src/index.html",
  "preload": "src/preload.cjs"
}
