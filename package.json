{
  "name": "com.matiq.schema",
  "productName": "DBSchema",
  "version": "0.1.0",
  "private": true,
  "license": "SEE LICENSE IN LICENSE",
  "engines": {
    "node": ">=22.12.0"
  },
  "main": "src/main.cjs",
  "scripts": {
    "start": "electron .",
    "prestart": "npm run build:ui && matiq-tool prototype check",
    "prepackage": "npm run build:ui && matiq-tool prototype check",
    "prototype": "npm run build:ui && matiq-tool prototype build",
    "prototype:check": "matiq-tool prototype check",
    "package": "electron-builder --publish never",
    "tool:validate": "matiq-tool validate",
    "tool:pack": "matiq-tool pack --output tool.mqt",
    "tool:pack-app": "matiq-tool pack-app",
    "build:ui": "esbuild src/app.mjs --bundle --format=iife --platform=browser --outfile=src/app.js --minify",
    "test": "node --test test/*.test.mjs",
    "test:native": "node scripts/native-test.cjs",
    "package:release": "node scripts/release.cjs"
  },
  "dependencies": {
    "@matiq-solutions/runtime": "https://github.com/GoMatiQ-inc/matiq-solutions/releases/download/sdk-v0.1.6/matiq-solutions-runtime-0.1.6.tgz",
    "@matiq-solutions/shell": "https://github.com/GoMatiQ-inc/matiq-solutions/releases/download/sdk-v0.1.6/matiq-solutions-shell-0.1.6.tgz"
  },
  "devDependencies": {
    "@matiq-solutions/sdk": "https://github.com/GoMatiQ-inc/matiq-solutions/releases/download/sdk-v0.1.6/matiq-solutions-sdk-0.1.6.tgz",
    "electron": "45.2.3",
    "electron-builder": "26.18.0",
    "playwright": "1.64.1",
    "@dbml/core": "12.1.0",
    "esbuild": "0.28.2",
    "papaparse": "5.7.1",
    "pdf-lib": "1.17.1"
  },
  "build": {
    "appId": "com.matiq.schema",
    "productName": "DBSchema",
    "icon": "node_modules/@matiq-solutions/shell/assets/app-icon.png",
    "mac": {
      "icon": "node_modules/@matiq-solutions/shell/assets/app-icon.icns",
      "target": [
        "dmg",
        "zip"
      ],
      "minimumSystemVersion": "14.2",
      "hardenedRuntime": true,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "artifactName": "DBSchema-${version}-mac-${arch}.${ext}"
    },
    "files": [
      "src/**/*",
      "matiq-tool.json",
      "package.json",
      "LICENSE"
    ],
    "directories": {
      "output": "dist"
    }
  },
  "description": "Local DBML schema design with interactive database diagrams",
  "author": "MatiQ Inc"
}
